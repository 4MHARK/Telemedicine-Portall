# The live API is the default. MSW is opt-in for isolated UI work in dev:
# VITE_ENABLE_MOCKS=true

# Where the browser sends API requests. Leave as /api to use the Vite proxy
# locally or the same-origin Netlify/Vercel rewrite in production.
# VITE_API_BASE_URL=/api

# Local development only: where Vite proxies /api when MSW is off.
# The server's PORT in server/.env must match.
# VITE_API_PROXY_TARGET=http://localhost:3001

# Paystack test public key. The secret key belongs only in server/.env.
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# Test-only: render a "Simulate payment" button instead of the Paystack popup.
# Never enable this in a live build.
# VITE_PAYMENTS_FAKE=true

# Show seeded patient/doctor credentials on the login page.
# VITE_SHOW_DEMO_ACCOUNTS=true

# Uncomment and set the deployment subpath (e.g. /telemedicine-portal/) when
# hosting under a path rather than at the domain root.
# VITE_BASE_PATH=/telemedicine-portal/
