# Copy to .env.local only if you are wiring the real backend.
# Leave unset for the mock-only fallback: MSW starts automatically in every build.
# VITE_DISABLE_MOCKS=true

# Local development only: where Vite proxies /api when MSW is disabled.
# The backend's default PORT is 3001. Change this if you set a different PORT.
# VITE_API_PROXY_TARGET=http://localhost:3001

# Uncomment and set the deployment subpath (e.g. /telemedicine-portal/) when
# hosting under a path rather than at the domain root.
# VITE_BASE_PATH=/telemedicine-portal/
