# Copy to .env.local only if you are wiring a real backend.
# Leave unset for the mock-only demo: MSW starts automatically in every build.
# VITE_DISABLE_MOCKS=true

# Uncomment and set the deployment subpath (e.g. /telemedicine-portal/) when
# hosting under a path rather than at the domain root.
# VITE_BASE_PATH=/telemedicine-portal/
