// Domain schema for the patient portal.
//
// The wire contract is src/types/*.ts in the frontend. This schema stores the
// same entities; enum values are uppercase in Postgres and lowercased by
// src/lib/serialize.ts on the way out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountRole {
  PATIENT
  DOCTOR
}

model Account {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         AccountRole
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  lastLoginAt  DateTime?
  patient      Patient?
  provider     Provider?
  sessions     Session[]
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  accountId  String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

enum ConsultationType {
  VIDEO
  PHONE
  ASYNC
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  PENDING_PAYMENT
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum DocumentStatus {
  QUEUED
  UPLOADING
  UPLOADED
  FAILED
}

enum SenderRole {
  PATIENT
  PROVIDER
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
  REFUND_PENDING
  REFUNDED
}

enum RefundStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  FAILED
}

model Patient {
  id                String   @id
  accountId         String   @unique
  firstName         String
  lastName          String
  phone             String
  dateOfBirth       DateTime
  avatarUrl         String?
  insuranceProvider String?
  insuranceMemberId String?
  createdAt         DateTime @default(now())

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  documents     Document[]
  conversations Conversation[]
  payments      Payment[]
}

model Specialty {
  id        String              @id
  name      String
  slug      String              @unique
  icon      String
  providers ProviderSpecialty[]
}

model Provider {
  id                String             @id
  accountId         String             @unique
  firstName         String
  lastName          String
  title             String
  bio               String
  avatarUrl         String
  yearsExperience   Int
  rating            Float
  reviewCount       Int
  languages         String[]
  consultationTypes ConsultationType[]
  isActive          Boolean            @default(true)

  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  specialties   ProviderSpecialty[]
  slots         AvailabilitySlot[]
  appointments  Appointment[]
  conversations Conversation[]
  fees          ConsultationFee[]
}

model ConsultationFee {
  id               String           @id @default(cuid())
  providerId       String
  consultationType ConsultationType
  amountMinor      Int
  currency         String           @default("NGN")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, consultationType])
}

model ProviderSpecialty {
  providerId  String
  specialtyId String

  provider  Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([providerId, specialtyId])
  @@index([specialtyId])
}

model AvailabilitySlot {
  id         String     @id
  providerId String
  start      DateTime
  end        DateTime
  status     SlotStatus @default(AVAILABLE)

  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([providerId, start])
  @@index([providerId, start])
}

model Appointment {
  id               String            @id @default(cuid())
  patientId        String
  providerId       String
  slotId           String
  consultationType ConsultationType
  status           AppointmentStatus @default(PENDING_PAYMENT)
  reason           String
  notes            String?
  scheduledAt      DateTime
  durationMinutes  Int
  amountMinor      Int
  currency         String            @default("NGN")
  holdExpiresAt    DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  cancelledAt      DateTime?
  cancelReason     String?

  patient   Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider  Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slot      AvailabilitySlot @relation(fields: [slotId], references: [id])
  documents Document[]
  payments  Payment[]

  @@index([patientId, scheduledAt])
  @@index([providerId, scheduledAt])
  @@index([slotId])
  @@index([status, holdExpiresAt])
}

model Payment {
  id                String        @id @default(cuid())
  appointmentId     String
  patientId         String
  reference         String        @unique
  providerReference String?
  amountMinor       Int
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  refundStatus      RefundStatus  @default(NOT_REQUIRED)
  authorizationUrl  String?
  accessCode        String?
  paidAt            DateTime?
  verifiedAt        DateTime?
  failureReason     String?
  createdAt         DateTime      @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([status])
}

model Document {
  id            String         @id @default(cuid())
  patientId     String
  appointmentId String?
  fileName      String
  mimeType      String
  sizeBytes     Int
  status        DocumentStatus @default(UPLOADED)
  uploadedAt    DateTime?
  failureReason String?
  // File bytes live in Postgres so uploads survive a Render restart.
  data          Bytes?
  createdAt     DateTime       @default(now())

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId, uploadedAt])
  @@index([appointmentId])
}

model Conversation {
  id                  String   @id
  patientId           String
  providerId          String
  lastMessageAt       DateTime
  lastMessagePreview  String
  patientUnreadCount  Int      @default(0)
  providerUnreadCount Int      @default(0)

  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([patientId, providerId])
  @@index([patientId, lastMessageAt])
  @@index([providerId, lastMessageAt])
}

model ChatMessage {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     SenderRole
  body           String
  sentAt         DateTime      @default(now())
  status         MessageStatus @default(SENT)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}
