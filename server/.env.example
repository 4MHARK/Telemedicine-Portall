# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@127.0.0.1:5432/telemedicine_portal_dev?schema=public
# Render: copy the "Internal Database URL" from the Postgres service.
DATABASE_URL=postgresql://telemedicine_app:REPLACE_ME@127.0.0.1:5432/telemedicine_portal_dev?schema=public
# Used by Prisma Migrate. On Supabase this is the session pooler (5432) while
# DATABASE_URL is the transaction pooler (6543). Locally it equals DATABASE_URL.
DIRECT_URL=postgresql://telemedicine_app:REPLACE_ME@127.0.0.1:5432/telemedicine_portal_dev?schema=public

# Session cookie lifetime in days. Sessions are opaque tokens stored hashed in
# the database; there is no JWT secret.
SESSION_TTL_DAYS=7
SESSION_IDLE_DAYS=7

# Comma-separated browser origins that may read responses directly.
# Unknown origins receive no CORS headers; the request is not rejected, so a
# same-origin Netlify/Vercel rewrite still works without an entry here.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Origin used by the CSRF backstop for cookie-authenticated writes.
APP_ORIGIN=http://localhost:5173

# Port Express listens on. Render injects PORT automatically.
PORT=3001
NODE_ENV=development

# How long a booking holds its slot before payment.
HOLD_TTL_MINUTES=10

# Required value of the x-seed-secret header on POST /api/seed.
# Generate with: openssl rand -hex 32
SEED_SECRET=REPLACE_ME
# Allow the destructive seed endpoint in production. Keep false unless needed.
ALLOW_SEED=false

# Passwords assigned to the seeded demo patients and doctors. Printed in the
# README. These are demo data, not production credentials.
DEMO_PASSWORD=demo-password-2026
DEMO_PROVIDER_PASSWORD=demo-password-2026

# Paystack test keys. The secret key stays server-side; the public key is a
# VITE_ variable in the frontend environment. Get them from the Paystack
# dashboard in Test mode.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
# Optional; the inline popup does not require a redirect URL.
PAYSTACK_CALLBACK_URL=
# Test-only fake provider. Never enable this in production.
PAYSTACK_FAKE=false
